example:Action3AgentRoleAddressee032024R0900 a rrmv:AgentRole ;
    rrmv:forAgent example:Agent932024R0900 ;
    rrmv:withRole rrmv-codes:addressee .

example:Action3AgentRoleAddresser032024R0900 a rrmv:AgentRole ;
