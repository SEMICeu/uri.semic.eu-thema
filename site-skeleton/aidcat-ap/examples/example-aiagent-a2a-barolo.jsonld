      "AiSystem.hasProvider": "http://example.com/Agent/agentcon-demo",
      "AiSystem.hasDeployer": "http://example.com/Agent/agentcon-demo",
      "AiSystem.intendedUse": "Demonstration of agent-to-agent commerce: natural-language or typed quotes and simulated orders for 2019 Barolo wine, with OID4VP age verification for purchases. Demo only: no payment or fulfilment.",
