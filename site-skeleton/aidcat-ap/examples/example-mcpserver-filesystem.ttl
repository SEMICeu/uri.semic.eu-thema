<http://example.com/MCPServer/server-filesystem> dct:title "@modelcontextprotocol/server-filesystem" ;
	dcat:version "2.3.0" ;
	dct:description "An MCP server for filesystem access, launched locally with npx over stdio." ;
	it6:hasRepository <https://github.com/modelcontextprotocol/servers> ;
	it6:hasManufacturer <http://example.com/Agent/model-context-protocol> ;
	dct:license <https://spdx.org/licenses/MIT.html> ;
	it6:transport <http://data.europa.eu/it6/codelist/transport/stdio> ;
	it6:supportedFeature <http://data.europa.eu/it6/codelist/supportedFeature/resources>, <http://data.europa.eu/it6/codelist/supportedFeature/tools> ;
	a it6:MCPServer .

