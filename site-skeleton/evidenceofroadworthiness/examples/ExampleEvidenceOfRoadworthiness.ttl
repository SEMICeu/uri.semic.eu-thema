@prefix auto-vc: <https://spec.edmcouncil.org/auto/ontology/VC/VehicleCore/> .
@prefix cv: <http://data.europa.eu/m8g/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.com/> .
@prefix legal: <http://www.w3.org/ns/legal#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdg: <http://data.europa.eu/p4s/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:evidenceof1 sdg:hasAttributeSet ex:attributeSet1 ;
	dct:subject ex:roadvehicle1 ;
	dct:requires ex:check1 ;
	a sdg:EvidenceOfRoadworthiness .

ex:attributeSet1 sdg:hasAttribute ex:attribute1, ex:attribute2 ;
	a sdg:AttributeSet .

ex:attribute1 rdfs:label "IssuingDate" ;
	rdf:value "2026-03-18"^^xsd:date ;
	a sdg:Attribute .

ex:attribute2 rdfs:label "IssuingAuthority" ;
	rdf:value "Departement of Transport"@en ;
	a sdg:Attribute .

ex:roadvehicle1 sdg:registrationPlateNumber "XY-AAA-XY" ;
    sdg:countrySymbolStateRegistration ex:I ;
	sdg:vehicleCategory ex:N2 ;
	auto-vc:vehicleIdentificationNumber "1GB4WLE72NF599922" ;
	a auto-vc:RoadVehicle .

ex:check1 auto-vc:validFrom "2026-03-05T09:00:00"^^xsd:dateTime ;
	auto-vc:validThrough "2028-03-05T09:00:00"^^xsd:dateTime ;
	sdg:odometerReading "15000"^^xsd:nonNegativeInteger ;
	sdg:placeRoadWorthinessTest <http://publications.europa.eu/resource/authority/country/ITA> ;
	dct:publisher ex:publisher1 ;
	a auto-vc:Check .

ex:publisher1 legal:legalName "OOTS Garage"@en ;
	a legal:LegalEntity .